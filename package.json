{
  "name": "respan-mcp",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/lib/index.js",
  "bin": {
    "respan-mcp": "dist/lib/index.js"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/client && mkdir -p dist/client && cp -R public/. dist/client/",
    "build:server": "tsc",
    "dev:oauth": "tsx scripts/oauth-dev-server.ts",
    "verify:oauth:local": "tsx scripts/verify-oauth-local.ts",
    "test": "vitest run",
    "stdio": "npm run build:server && node dist/lib/index.js",
    "start": "node dist/lib/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@respan/respan-api": "^0.1.16",
    "@upstash/redis": "^1.38.0",
    "dotenv": "^17.4.2",
    "redis": "^6.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vercel/node": "^5.5.16",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "protobufjs": "^7.6.5",
    "qs": "^6.15.3"
  }
}
