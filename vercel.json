{
  "framework": null,
  "buildCommand": "npm ci && npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/enterprise", "destination": "/api/mcp/enterprise" },
    { "source": "/mcp/docs", "destination": "/api/mcp/docs" },
    { "source": "/auth", "destination": "/api/auth" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/mcp/enterprise", "destination": "/api/well-known/oauth-protected-resource-enterprise" },
    { "source": "/.well-known/oauth-protected-resource/enterprise", "destination": "/api/well-known/oauth-protected-resource-enterprise" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known/oauth-authorization-server" },
    { "source": "/enterprise-oauth/.well-known/oauth-authorization-server", "destination": "/api/well-known/oauth-authorization-server-enterprise" },
    { "source": "/.well-known/oauth-authorization-server/enterprise-oauth", "destination": "/api/well-known/oauth-authorization-server-enterprise" },
    { "source": "/register", "destination": "/api/oauth/register" },
    { "source": "/authorize", "destination": "/api/oauth/authorize" },
    { "source": "/authorize/enterprise", "destination": "/api/oauth/authorize-enterprise" },
    { "source": "/oauth/code", "destination": "/api/oauth/code" },
    { "source": "/token", "destination": "/api/oauth/token" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "MCP-Protocol-Version" }
      ]
    },
    {
      "source": "/register",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, MCP-Protocol-Version" }
      ]
    },
    {
      "source": "/token",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, MCP-Protocol-Version" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'sha256-Ccs6f8zCGgPjYKTgZcG3fRas8aOTOlHTqaAdiUZR9Hw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/login.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'sha256-Ccs6f8zCGgPjYKTgZcG3fRas8aOTOlHTqaAdiUZR9Hw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 800
    },
    "api/mcp/enterprise.ts": {
      "maxDuration": 800
    },
    "api/mcp/docs.ts": {
      "maxDuration": 30
    },
    "api/auth.ts": {
      "maxDuration": 30
    },
    "api/well-known/oauth-protected-resource.ts": {
      "maxDuration": 10
    },
    "api/well-known/oauth-protected-resource-enterprise.ts": {
      "maxDuration": 10
    },
    "api/well-known/oauth-authorization-server.ts": {
      "maxDuration": 10
    },
    "api/well-known/oauth-authorization-server-enterprise.ts": {
      "maxDuration": 10
    },
    "api/oauth/register.ts": {
      "maxDuration": 10
    },
    "api/oauth/authorize.ts": {
      "maxDuration": 10
    },
    "api/oauth/authorize-enterprise.ts": {
      "maxDuration": 10
    },
    "api/oauth/code.ts": {
      "maxDuration": 10
    },
    "api/oauth/token.ts": {
      "maxDuration": 10
    }
  }
}
