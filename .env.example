# Respan MCP Server - Environment Variables

# Required: Your Respan API key (for stdio mode)
# RESPAN_API_KEY=your_respan_api_key

# Optional: Override the default API base URL
# RESPAN_API_BASE_URL=https://api.respan.ai/api

# Public OAuth broker (required for hosted MCP deployments)
# Generate OAUTH_SECRET with at least 32 random characters and store it only
# in the deployment secret manager.
# OAUTH_SECRET=
# OAUTH_SESSION_STORE=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# MCP_PUBLIC_BASE_URL=https://mcp.respan.ai
# MCP_REDIS_KEY_PREFIX=respan-mcp:production:
# MCP_ACCESS_TOKEN_TTL_SECONDS=14400
# RESPAN_ENTERPRISE_API_BASE_URL=https://endpoint.respan.ai/api
